# Copy to .env and fill in the first three. Everything else is optional.

# From the Discord developer portal: your application > Bot > Reset Token.
DISCORD_TOKEN=

# With Developer Mode on in Discord, right-click a channel > Copy Channel ID.
# The voice channel the bot listens in:
VOICE_CHANNEL_ID=
# The text channel it writes to (defaults to the server's system channel):
ALERT_CHANNEL_ID=

# Comma-separated wake words.
# WAKE_WORDS=bot,shamash

# One ISO-639-1 code (en, pt, es). Leave unset if more than one language is spoken.
# ASR_LANGUAGE=en

# English only, and no GPU? This model answers in ~0.1 s on a CPU.
# REQUEST_MODEL=handy-computer/parakeet-tdt-0.6b-v2-gguf/parakeet-tdt-0.6b-v2-Q8_0.gguf

# When several artists recorded the title asked for: ask, auto or popular.
# AMBIGUOUS_POLICY=ask

# Where songs picked from "Which one?" are remembered; off remembers nothing.
# LIBRARY_PATH=data/library.json

# Docker only: skip updating yt-dlp at startup.
# YTDLP_UPDATE=off
